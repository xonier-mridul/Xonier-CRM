# Copy to .env; never commit .env. Use the CRM's existing Mongo database.
MONGO_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=xonier
# Same random secret in the FastAPI backend WHATSAPP_BRIDGE_SECRET.
WHATSAPP_BRIDGE_SECRET=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and backed up. Changing it makes saved sessions unreadable.
WHATSAPP_SESSION_KEY=
WHATSAPP_BRIDGE_HOST=127.0.0.1
WHATSAPP_BRIDGE_PORT=3101
