# Append to the backend .env. Do not replace existing CRM settings.
CHAT_ENABLED=true
# Optional TLS/authenticated Redis URL. Otherwise REDIS_HOST/REDIS_PORT are reused.
CHAT_REDIS_URL=
# Comma-separated exact browser origins, in addition to CLIENT_URL.
CHAT_ALLOWED_ORIGINS=https://app.trakeroo.com
CHAT_MAX_MEMBERS=100
CHAT_MAX_FILE_BYTES=26214400

# Private S3 bucket; use an EC2 IAM instance role for credentials.
CHAT_S3_BUCKET=
CHAT_S3_REGION=ap-south-1
# ClamAV TCP service on a PRIVATE interface, never exposed to the Internet.
CHAT_CLAMAV_HOST=
CHAT_CLAMAV_PORT=3310

# LiveKit Cloud or a self-hosted server. These are BACKEND-ONLY credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CHAT_MAX_CALL_PARTICIPANTS=16
