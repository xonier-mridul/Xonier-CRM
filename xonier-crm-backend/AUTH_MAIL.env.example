# Append these to the EXISTING backend environment. Never replace existing
# MongoDB, Fernet, JWT, SECRET_KEY, SMTP or other CRM credentials with examples.
AUTH_ACCESS_SECONDS=900
AUTH_OTP_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
# Independent takeover policy for the web slot and native-mobile slot.
AUTH_TAKEOVER_COOLDOWN_SECONDS=300
AUTH_TAKEOVER_WINDOW_SECONDS=1800
AUTH_TAKEOVER_MAX=3
AUTH_TAKEOVER_LOCK_SECONDS=1800
AUTH_REFRESH_GRACE_SECONDS=10

# Production SMTP uses existing EMAIL_HOST/PORT/USER/PASS and FROM_EMAIL.
# auto routes ENV=development/dev/local to a loopback-only Mailpit inbox.
# Start: docker compose -f deploy/compose.dev-mail.yml up -d
# Read ALL dev mail (including fake recipients): http://127.0.0.1:8025
# smtp explicitly uses your real provider locally. mailpit is forbidden in prod.
MAIL_DELIVERY_MODE=auto
MAIL_DEV_SMTP_PORT=1025
# auto starts both queue consumers with the API for ENV=development/dev/local.
# Production/staging still require the separately supervised worker services.
# Use external to disable local embedded consumers when running separate workers.
MAIL_WORKER_MODE=auto
# Real SMTP: implicit TLS on 465, required STARTTLS otherwise. Never plaintext.
# Only development Mailpit uses plaintext on fixed 127.0.0.1 without credentials.
MAIL_SMTP_TLS=auto
MAIL_SMTP_TIMEOUT_SECONDS=30
MAIL_LEASE_SECONDS=180
MAIL_MAX_ATTEMPTS=6
MAIL_MAX_MESSAGE_BYTES=1048576
# Shared across all worker processes; choose below your provider's quota.
MAIL_RATE_PER_SECOND=5
MAIL_WORKER_CONCURRENCY=2
MAIL_RETENTION_DAYS=30
