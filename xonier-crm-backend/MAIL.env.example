# Configure once for the CRM. No paid integration subscription.
# Google (the existing callback remains supported)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
# Microsoft: supports personal Outlook/Hotmail/Live and Microsoft 365 work accounts.
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_REDIRECT_URI=http://localhost:8000/api/mail/oauth/microsoft/callback
